import { chromium } from '@playwright/test';
import { openAs } from './helpers';
const b = await chromium.launch();
const p = await b.newPage({ viewport: { width: 1440, height: 900 } });
await openAs(p, 'u_rahul', '/quotations', { theme: 'light' });
const id = await p.evaluate(() => { const db = JSON.parse(localStorage.getItem('tc.crm.db.v1')!); return db.records.quotations.find((q: any) => q.status === 'sent' && q.isLatest && db.records.opportunities.some((o: any) => o.id === q.opportunityId && o.leadId))?.id; });
await p.goto('/quotations?drawer=quotations:' + id);
await p.waitForTimeout(2200);
const d = p.locator('.inspector-drawer, .inspector').first();
await d.screenshot({ path: '/private/tmp/claude-501/-Users-maysolanki-Documents-True-Color-tc-frontend/6db01995-7c70-4313-86c1-2f272049ad5b/scratchpad/drawer.png' });
console.log(id, await p.url());
await b.close();
